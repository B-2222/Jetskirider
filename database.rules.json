{
  "rules": {
    "jetski": {
      "$room": {
        ".read": "$room === 'lobby' || $room === 'lobby-1' || $room === 'lobby-2'",
        "$peer": {
          ".write": "($room === 'lobby' || $room === 'lobby-1' || $room === 'lobby-2') && $peer.matches(/^[a-z0-9]{12}$/)",
          ".validate": "newData.hasChildren(['s', 't'])",
          "s": { ".validate": "newData.isString() && newData.val().length <= 1200" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "stats": {
      ".read": true,
      "players": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "boards": {
      ".read": true,
      "$week": {
        "$board": {
          ".indexOn": ["v"],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $week.matches(/^w[0-9]{4,6}$/) && $board.matches(/^(tricks|race-(bay|reef|lake|storm|gorge|beach))$/)",
            ".validate": "newData.hasChildren(['n', 'v', 't'])",
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "v": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 10000000" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "reports": {
      ".read": false,
      "$day": {
        "$id": {
          ".write": "!data.exists() && $day.matches(/^d[0-9]{8}$/) && $id.matches(/^[a-z0-9]{6,12}$/)",
          ".validate": "newData.hasChildren(['by', 'who', 'why', 't'])",
          "by": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "who": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "why": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['c', 't'])",
        "c": { ".validate": "newData.isString() && newData.val().length <= 20000" },
        "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
